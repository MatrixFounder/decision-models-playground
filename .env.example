# Decision Models Playground — пути, ключи, лимиты (docs/DESIGN.md §17.1).
# Скопируйте в .env и выставьте права 600. Ключи не попадают в runs/, логи и ответы API.

OPENROUTER_API_KEY=
# Bearer compat-сервера /v1/systemone; не короче 32 символов; обязателен, если COMPAT_HOST не loopback.
SYSTEMONE_TOKEN=

APP_HOST=127.0.0.1
APP_PORT=8790
COMPAT_HOST=127.0.0.1
COMPAT_PORT=8791

# Кэш моделей Hugging Face (по умолчанию системный).
HF_HOME=
DAILY_BUDGET_USD=1.0
FFMPEG_BIN=ffmpeg
DATA_DIR=.
