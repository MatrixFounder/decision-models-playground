# Decision Models Playground — keys, hosts, limits (docs/ARCHITECTURE.md §10).
# Copy to .env and set mode 600 (`make setup` does both). Keys never reach runs/, logs or API answers;
# a .env readable by other users gives a warning at start.

# OpenRouter key for the cloud engines; without it they are unavailable.
OPENROUTER_API_KEY=
# OpenRouter root for the model catalog and decision calls: a proxy or gateway (LiteLLM…) instead of OpenRouter.
# The key is sent here, so https only (http only to 127.0.0.1 or localhost). One engine: its own base_url in config.yaml.
OPENROUTER_BASE_URL=https://openrouter.ai
# Bearer token of the compat server /v1/systemone: at least 32 characters, 10 or more distinct
# (`openssl rand -hex 24`). Required when COMPAT_HOST is not loopback.
SYSTEMONE_TOKEN=

# UI and /api: 127.0.0.1 or localhost only (the UI has no authentication).
APP_HOST=127.0.0.1
APP_PORT=8790
# Compat server: 0.0.0.0 (or an IPv4 address or host name) opens it to the LAN and needs SYSTEMONE_TOKEN.
COMPAT_HOST=127.0.0.1
COMPAT_PORT=8791

# Hugging Face model cache (empty: the system default).
HF_HOME=
# Daily limit on paid calls, USD: a finite number ≥ 0, otherwise the process does not start.
DAILY_BUDGET_USD=1.0
# ffmpeg for audio uploads (brew install ffmpeg).
FFMPEG_BIN=ffmpeg
# Root of runs/, datasets/, probes/, reports/, media/; relative to the repository.
DATA_DIR=.
# Engine registry file; relative to the repository.
# CONFIG_PATH=config.yaml

# Read from the process environment only, not from this file:
#   HF_HUB_OFFLINE=1          no network to Hugging Face; local snapshots get no date
#   D1_VISION_MAX_PIXELS=N    d1's picture pixel cap (as mlx-vlm reads it); the preflight token count follows it
